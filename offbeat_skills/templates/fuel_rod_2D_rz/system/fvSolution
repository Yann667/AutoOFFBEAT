FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "D|DD"
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          1e-3;
    }
    
    T
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          1e-3;
    }

    neutronFlux0
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }
}

stressAnalysis
{
    nCorrectors     
    {
        default 1;
        D 6;
    }

    maxOuterIter    1000;

    referencePairs  ();

    D                   (1e-5 1 1e-5);
    T                   1e-5;
    neutronFlux0        1e-5;

    relD                1e-6;
    relT                1e-6;
    relneutronFlux0     1e-6;
}

relaxationFactors
{
    fields
    {
        D   0.9;
        // T   0.9;
        // neutronFlux0   0.9;
    }
    equations
    {
        // D 0.99;
    }
}

