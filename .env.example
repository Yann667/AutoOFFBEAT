# AutoOFFBEAT — configuration template.
# Copy to .env and fill in. NEVER commit a filled-in .env (it is gitignored).

# ── Language model provider ───────────────────────────────────────────────────
# ollama (local, free, no key) | anthropic | gemini
LLM_PROVIDER=ollama

# Ollama (default: runs fully offline)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# Context window. The default 4096 is too small: the system prompt and tool
# schemas alone consume ~47 % of it before any exchange.
OLLAMA_NUM_CTX=16384

# Embeddings for the documentary assistant. MUST be multilingual: the corpus is
# bilingual (English upstream docs, French project docs) and a monolingual model
# never crosses the language barrier — measured at 0/11 retrieval.
EMBED_MODEL=bge-m3

# Cloud providers — only if LLM_PROVIDER is set accordingly
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ── OFFBEAT / OpenFOAM ────────────────────────────────────────────────────────
# Absolute path to the compiled solver binary and to blockMesh.
OFFBEAT_BIN=/home/<user>/OpenFOAM/<user>-v2506/platforms/linux64GccDPInt32Opt/bin/offbeat
BLOCKMESH_BIN=/usr/lib/openfoam/openfoam2506/platforms/linux64GccDPInt32Opt/bin/blockMesh
# Solver timeout in seconds (a full cycle takes ~36 s; leave headroom).
OFFBEAT_TIMEOUT_S=28800
SELF_HEALING_MAX_RETRIES=3

# ── Web interface ─────────────────────────────────────────────────────────────
PORT=8000
DEBUG=false
MPLCONFIGDIR=/tmp/matplotlib
